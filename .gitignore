__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.local

# Node backend (backend/). Dependencies are restored from the committed
# package-lock.json; the tree itself is never committed.
node_modules/

# Build outputs
.cache/
# NOTE: docs/ is intentionally NOT gitignored — Pages serves from there.
# Transient atomic-swap dirs (web/build.py). Present only mid-build or after
# a failed build; the next build cleans them. Never committed.
/.docs.build-tmp/
/.docs.build-old/

# Non-published scraper outputs. Anything written under private/ stays out
# of git and out of the served docs/ directory. One-source principle:
# publish nothing HCSO does not publish.
private/

# Ephemeral
*.log
*.lock
desktop.ini
Thumbs.db
.DS_Store
.pytest_cache/
# .claude/ — local agent-worktree harness state stays ignored, but durable
# project skills + paired subagents are tracked so collaborators (and CI's
# Claude jobs) get the same context. Use .claude/* (contents) rather than
# .claude/ (the dir itself) so git can descend and pick up the un-ignored
# children — git can't re-include a path whose parent dir is excluded.
.claude/*
!.claude/skills/
!.claude/agents/
.claude.zip
HCJC.zip
.claude/skills/All skills.zip
.claude/agents/md skills.zip
hcjc-agentic-audit-prompt.md
# Per-inmate PRA letters stay untracked. Packet + history files are committed.
pra_requests/*/*.md
!pra_requests/*/README.md
!pra_requests/*/PACKET.md

# deploy_fix.py run artifacts. Both are regenerated on each run and carry a
# snapshot of roster damage counts, so they are operational output rather than
# source. (`.deployment.log` is already covered by `*.log` above; it is named
# here too so the pairing is discoverable.)
.deployment.log
.incident_summary.json
