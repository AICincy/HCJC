# JCStream backend environment.
#
# Copy to `.env` for local runs. `.env` is gitignored at the repository root.
# Node does not read this file on its own; pass it explicitly:
#
#   npm run start:local
#
# In CI these are supplied by the workflow, not by this file.
#
# The publishable key is public by design. Committing it is fine.
# The secret key bypasses Row-Level Security. It must never be committed,
# pasted into a chat, or written to a log. Set it as a repository secret:
#
#   Settings > Secrets and variables > Actions > New repository secret
#   name: JCSTREAM_SUPABASE_SECRET_KEY
#
# The workflow maps it onto the SUPABASE_SECRET_KEY name the library reads.

SUPABASE_URL=https://chanipklvuiskygkwsuf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ewVaqXhSIn0YYikBnIaNMw_TvORBgla
SUPABASE_JWKS_URL=https://chanipklvuiskygkwsuf.supabase.co/auth/v1/.well-known/jwks.json

# Leave empty locally. Supplied by the JCSTREAM_SUPABASE_SECRET_KEY secret.
SUPABASE_SECRET_KEY=
